package templates

import (
	"main/entities"
)

templ ArticleListPage(articles []*entities.Article) {
	<section>
		<ol>
			for _, article := range articles {
				<li>
					<a style="width: 100%; display: block;" href={ templ.URL("/articles/" + article.Metadata.Path) }>
						<span>{ article.Metadata.Name }</span>
					</a>
				</li>
			}
		</ol>
	</section>
}
